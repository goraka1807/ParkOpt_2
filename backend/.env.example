# ParkOpt Backend Environment Configuration
#
# Purpose: Template showing all required environment variables.
#          NEVER commit real credentials to Git.
#          Copy this file to .env.local and fill in real values.
#
# Two environments:
# - LOCAL DEVELOPMENT: Values from Supabase local emulator or cloud project
# - PRODUCTION: Values from your Supabase cloud project settings

# ==============================================================================
# SUPABASE PROJECT SETTINGS
# Found at: Supabase Dashboard > Project Settings > API
# ==============================================================================

# Your Supabase project URL (safe to expose in frontend)
SUPABASE_URL=https://your-project-id.supabase.co

# Anon/public key (safe to use in browser — RLS enforces access control)
SUPABASE_ANON_KEY=your-anon-key-here

# Service role key — ONLY used in Edge Functions / server-side code.
# NEVER expose this in the frontend or commit it to source control.
# It bypasses RLS and has full database access.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret — used to verify tokens in custom server-side logic.
# Found at: Supabase Dashboard > Project Settings > API > JWT Settings
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ==============================================================================
# GOOGLE MAPS PLATFORM
# Required for: geocoding, place search, distance calculation
# Console: https://console.cloud.google.com/
# APIs needed:
#   - Maps JavaScript API (browser key)
#   - Geocoding API (server key)
#   - Places API (server key)
#   - Distance Matrix API (server key - optional)
# ==============================================================================

# Browser-restricted key (restrict to your domain + Maps JS API only)
VITE_GOOGLE_MAPS_API_KEY=your-browser-maps-key-here

# Server-side key (restrict to server IP + Geocoding/Places APIs)
# Used only in Edge Functions — NEVER in frontend
GOOGLE_MAPS_SERVER_KEY=your-server-maps-key-here

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================

# Minimum booking duration in hours (enforced server-side too, this is for docs)
MIN_BOOKING_HOURS=2

# Default search radius in kilometres
DEFAULT_SEARCH_RADIUS_KM=5

# Currency: paisa per rupee (100 paisa = 1 INR)
CURRENCY_SUBUNIT=100

# ==============================================================================
# PAYMENT PROVIDER (Future — Razorpay for India)
# Uncomment when payment integration is implemented.
# ==============================================================================
# RAZORPAY_KEY_ID=rzp_test_your-key-id
# RAZORPAY_KEY_SECRET=your-razorpay-secret
# RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# ==============================================================================
# EMAIL / NOTIFICATIONS (Future)
# ==============================================================================
# RESEND_API_KEY=re_your-key-here
# FROM_EMAIL=noreply@parkopt.in

# ==============================================================================
# FRONTEND CONFIGURATION (Vite environment variables)
# Variables prefixed with VITE_ are available in the React frontend.
# Do NOT prefix secrets with VITE_ — they would be bundled into the browser.
# ==============================================================================
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_APP_NAME=ParkOpt
VITE_DEFAULT_CITY=Bengaluru
VITE_DEFAULT_LAT=12.9716
VITE_DEFAULT_LNG=77.5946
